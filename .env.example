# Copy this file to `.env` (same folder) and fill in what you need.
# The server loads it automatically on start. Real shell env vars still win.

# --- Vani AI assistant (optional) -------------------------------------
# Get a key at https://console.anthropic.com/ . Without it the AI chat tab
# just shows "disabled"; everything else works normally.
ANTHROPIC_API_KEY=

# Model for the assistant (default: claude-sonnet-5)
# NEXUSFLOW_AI_MODEL=claude-sonnet-5

# --- Remote / LAN access (optional) ----------------------------------
# Set a long random string to allow access from other machines with
# `Authorization: Bearer <token>` (and `?token=` on the WebSocket).
# Leave empty for localhost-only mode.
NEXUSFLOW_AUTH_TOKEN=

# Comma-separated browser origins allowed to open the WebSocket
# (only needed with NEXUSFLOW_AUTH_TOKEN set and a non-localhost origin).
# NEXUSFLOW_ALLOWED_ORIGINS=http://localhost:3000

# --- Misc ----------------------------------------------------------------
# PORT=3000
# NEXUSFLOW_NO_BROWSER=1   # don't auto-launch Chrome on start
